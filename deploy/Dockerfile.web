# syntax=docker/dockerfile:1
#
# The admin SPA, built and then served by nginx.
#
# nginx also proxies /api to the control plane, which is the production shape of the same decision
# the Vite dev server makes: the browser must see ONE origin. The session is a cookie and the CSRF
# defence is a cookie copied into a header -- both same-origin mechanisms. Serving the SPA from a
# second origin would mean CORS, credentialed cross-origin requests and SameSite=None on the
# session cookie: three loosened settings to work around a problem a reverse proxy removes.

FROM node:20-alpine AS build

WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/web-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
