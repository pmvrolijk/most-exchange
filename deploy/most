#!/usr/bin/env bash
# The `most` CLI against the dev stack, with the connection flags filled in.
#
#   ./deploy/most securities
#   ./deploy/most book --symbol AAPL --depth 5 --refresh 500
#   ./deploy/most send --symbol AAPL --side buy --price 100.00 --qty 10 \
#       --clordid 1 --participant 7 --follow 3
#
# The CLI is an Aeron client on the OUTSIDE of the shard: it has its own media driver and reaches
# the gateway over UDP, exactly as a FIX adapter will. It learns the gateway's endpoints from the
# discovery broadcast rather than being told them.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

exec docker compose run --rm most "$@" \
  --aeron-dir /aeron/driver \
  --discovery-channel "aeron:udp?endpoint=0.0.0.0:0|control=shard0:40000|control-mode=dynamic" \
  --discovery-stream 100 \
  --l1-channel "aeron:udp?endpoint=0.0.0.0:0|control=shard0:40001|control-mode=dynamic" \
  --l1-stream 1 \
  --l2-channel "aeron:udp?endpoint=0.0.0.0:0|control=shard0:40002|control-mode=dynamic" \
  --l2-stream 2
